# Discord Bot トークン
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API キー
GEMINI_API_KEY=your_gemini_api_key_here

# テキストチャンネル設定（既存機能）
MEMO_CHANNEL_ID=your_memo_channel_id
RESEARCH_CHANNEL_ID=your_research_channel_id
COO_CHANNEL_ID=your_coo_channel_id
STATUS_CHANNEL_ID=your_status_channel_id
VAULT_PATH=/path/to/your/obsidian/vault

# ==========================================
# 🎙️ 音声思考ログ・文字起こし設定
# ==========================================
# 音声を拾うボイスチャンネルのID（入室すると自動で録音開始、退出で文字起こし）
VOICE_CHANNEL_ID=your_voice_channel_id

# 思考ログを投稿するテキストチャンネルのID
# （未設定の場合は、VOICE_CHANNEL_ID のチャット欄に投稿されます）
TRANSCRIPT_CHANNEL_ID=your_transcript_text_channel_id

# 文字起こしに使用するGeminiモデル（デフォルト: gemini-3.6-flash）
# VOICE_GEMINI_MODEL=gemini-3.6-flash

# 文字起こしした思考ログをそのままObsidianの00_Inboxにも自動保存＆Git同期するか（true / false）
# SYNC_THOUGHT_TO_OBSIDIAN=false
